# ---------- Terraform ----------
# State holds resource IDs and secrets (the RDS password). Never commit it.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfplan
plan.out
plan.json
outputs.json
validation.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Written on every stage by infraflow.local
stage.auto.tfvars.json
.infraflow-local.json
# Variable files that contain secrets must be named *.secret.tfvars(.json)
*.secret.tfvars
*.secret.tfvars.json
# Lambda and CodeBuild archives produced by archive_file
platform/.build/
# .terraform.lock.hcl is committed: it pins provider versions.

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node ----------
node_modules/
dist/

# ---------- Secrets and AWS ----------
*.pem
*.key
.env
.env.*
.aws/
credentials

# ---------- Operating system and editors ----------
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
.idea/
*.swp
*~
