{
 "blueprints": {
  "web-db@1.0.0": {
   "bindings": [
    {
     "from": "egress.net",
     "to": "network.net"
    },
    {
     "from": "database.net",
     "to": "network.net"
    },
    {
     "from": "app.net",
     "to": "network.net"
    },
    {
     "from": "app.egress",
     "to": "egress.egress"
    },
    {
     "from": "app.db",
     "to": "database.db"
    },
    {
     "from": "app.workload",
     "to": "sys.lease_app"
    },
    {
     "from": "entry.net",
     "to": "network.net"
    },
    {
     "from": "entry.backend",
     "to": "app.http"
    },
    {
     "from": "sys.dns",
     "to": "entry.public"
    }
   ],
   "blueprint": {
    "name": "web-db",
    "owner": "infraflow",
    "summary": "Web app (Docker trên EC2) + PostgreSQL + ALB",
    "version": "1.0.0"
   },
   "ics_version": "0.1",
   "instances": {
    "app": {
     "component": "aws-ec2-docker-app@1.0.0",
     "parameters": {
      "size": "${param.size}"
     }
    },
    "database": {
     "component": "aws-rds-postgres@1.0.0",
     "parameters": {
      "size": "${param.size}"
     }
    },
    "egress": {
     "component": "aws-nat-egress@1.0.0"
    },
    "entry": {
     "component": "aws-alb-https-entry@1.0.0"
    },
    "network": {
     "component": "aws-network-basic@1.0.0"
    }
   },
   "parameters": {
    "size": {
     "default": "small",
     "enum": [
      "small",
      "medium"
     ],
     "type": "string"
    }
   },
   "supported_levels": [
    "awake",
    "deep",
    "hibernate"
   ]
  }
 },
 "components": {
  "aws-alb-https-entry@1.0.0": {
   "_dir": "components/aws-alb-https-entry/1.0.0",
   "component": {
    "billing_class": "hourly_no_data",
    "data_class": "none",
    "data_resource_types": [],
    "name": "aws-alb-https-entry",
    "owner": "infraflow",
    "primary_resource": "aws_lb.this",
    "resource_types": [
     "aws_lb",
     "aws_lb_target_group",
     "aws_lb_target_group_attachment",
     "aws_lb_listener",
     "aws_security_group",
     "aws_vpc_security_group_ingress_rule",
     "aws_vpc_security_group_egress_rule"
    ],
    "summary": "ALB công khai ở 2 public subnet; HTTPS khi có chứng chỉ",
    "system_inputs": [
     "name_prefix",
     "certificate_arn"
    ],
    "version": "1.0.0"
   },
   "conformance": {
    "claimed_level": "L2"
   },
   "cost": [
    {
     "in_states": [
      "PRESENT"
     ],
     "meter": "alb_hour"
    },
    {
     "count": 2,
     "in_states": [
      "PRESENT"
     ],
     "meter": "public_ipv4_hour"
    }
   ],
   "health": {
    "probe": {
     "driver": "elbv2.target_healthy",
     "timeout_s": 900
    }
   },
   "ics_version": "0.1",
   "lifecycle": {
    "actions": {
     "observe": {
      "driver": "elbv2.describe"
     }
    },
    "levels": {
     "awake": "PRESENT",
     "deep": "ABSENT",
     "hibernate": "ABSENT",
     "shallow": "PRESENT"
    },
    "presence_variable": "present",
    "serving_states": [
     "PRESENT"
    ]
   },
   "outputs": {
    "dns_name": {
     "stable": false
    },
    "target_group_arn": {
     "stable": false
    },
    "zone_id": {
     "stable": true
    }
   },
   "parameters": {},
   "provides": [
    {
     "attributes": {
      "dns_name": "dns_name",
      "zone_id": "zone_id"
     },
     "port": "public",
     "type": "http.public/v1"
    }
   ],
   "requires": [
    {
     "inputs": {
      "public_subnet_ids": "public_subnet_ids",
      "vpc_id": "vpc_id"
     },
     "port": "net",
     "type": "net.vpc/v1",
     "when": "present"
    },
    {
     "inputs": {
      "health_path": "health_path",
      "instance_id": "target_instance_id",
      "port": "target_port",
      "security_group_id": "target_security_group_id"
     },
     "port": "backend",
     "type": "http.backend/v1",
     "when": "serving"
    }
   ]
  },
  "aws-ec2-docker-app@1.0.0": {
   "_dir": "components/aws-ec2-docker-app/1.0.0",
   "component": {
    "billing_class": "stoppable",
    "data_class": "none",
    "data_resource_types": [],
    "name": "aws-ec2-docker-app",
    "owner": "infraflow",
    "primary_resource": "aws_instance.app",
    "resource_types": [
     "aws_instance",
     "aws_security_group",
     "aws_vpc_security_group_egress_rule",
     "aws_vpc_security_group_ingress_rule",
     "aws_iam_role",
     "aws_iam_role_policy",
     "aws_iam_role_policy_attachment",
     "aws_iam_instance_profile"
    ],
    "summary": "EC2 Amazon Linux 2023 ở private subnet chạy một Docker image",
    "system_inputs": [
     "name_prefix",
     "env_id"
    ],
    "version": "1.0.0"
   },
   "conformance": {
    "claimed_level": "L2"
   },
   "cost": [
    {
     "in_states": [
      "RUNNING"
     ],
     "meter": "ec2_instance_hour",
     "param": "size"
    },
    {
     "in_states": [
      "RUNNING",
      "STOPPED"
     ],
     "meter": "ebs_gb_month",
     "param": "root_volume_gb"
    }
   ],
   "health": {
    "probe": {
     "driver": "ec2_instance.status_ok",
     "timeout_s": 600
    }
   },
   "ics_version": "0.1",
   "lifecycle": {
    "actions": {
     "observe": {
      "driver": "ec2_instance.describe"
     },
     "start": {
      "driver": "ec2_instance.start"
     },
     "stop": {
      "driver": "ec2_instance.stop"
     }
    },
    "levels": {
     "awake": "RUNNING",
     "deep": "STOPPED",
     "hibernate": "ABSENT",
     "shallow": "STOPPED"
    },
    "presence_variable": "present",
    "serving_states": [
     "RUNNING"
    ]
   },
   "outputs": {
    "health_path": {
     "stable": true
    },
    "instance_id": {
     "stable": true
    },
    "port": {
     "stable": true
    },
    "security_group_id": {
     "stable": true
    }
   },
   "parameters": {
    "size": {
     "default": "small",
     "enum": [
      "small",
      "medium"
     ],
     "type": "string"
    }
   },
   "provides": [
    {
     "attributes": {
      "health_path": "health_path",
      "instance_id": "instance_id",
      "port": "port",
      "security_group_id": "security_group_id"
     },
     "port": "http",
     "type": "http.backend/v1"
    }
   ],
   "requires": [
    {
     "inputs": {
      "private_subnet_ids": "subnet_ids",
      "vpc_id": "vpc_id"
     },
     "port": "net",
     "type": "net.vpc/v1",
     "when": "present"
    },
    {
     "port": "egress",
     "type": "net.egress/v1",
     "when": "serving"
    },
    {
     "inputs": {
      "host": "db_host",
      "name": "db_name",
      "password_param": "db_password_param",
      "port": "db_port",
      "security_group_id": "db_security_group_id",
      "user": "db_user"
     },
     "port": "db",
     "type": "db.postgres/v1",
     "when": "serving"
    },
    {
     "inputs": {
      "health_path": "app_health_path",
      "image": "app_image",
      "port": "app_port"
     },
     "port": "workload",
     "type": "workload.container/v1",
     "when": "present"
    }
   ]
  },
