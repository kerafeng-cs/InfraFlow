  "aws-rds-postgres@1.0.0": {
   "_dir": "components/aws-rds-postgres/1.0.0",
   "component": {
    "billing_class": "data",
    "data_class": "persistent",
    "data_resource_types": [
     "aws_db_instance"
    ],
    "name": "aws-rds-postgres",
    "owner": "infraflow",
    "primary_resource": "aws_db_instance.this",
    "resource_types": [
     "aws_db_instance",
     "aws_db_subnet_group",
     "aws_security_group",
     "aws_vpc_security_group_ingress_rule",
     "random_password",
     "aws_ssm_parameter"
    ],
    "summary": "PostgreSQL 16 trên RDS, single-AZ",
    "system_inputs": [
     "name_prefix",
     "env_id"
    ],
    "version": "1.0.0"
   },
   "conformance": {
    "claimed_level": "L3"
   },
   "cost": [
    {
     "in_states": [
      "RUNNING"
     ],
     "meter": "rds_instance_hour",
     "param": "size"
    },
    {
     "in_states": [
      "RUNNING",
      "STOPPED"
     ],
     "meter": "rds_storage_gb_month",
     "param": "allocated_storage_gb"
    },
    {
     "in_states": [
      "SNAPSHOTTED"
     ],
     "meter": "snapshot_gb_month"
    }
   ],
   "health": {
    "probe": {
     "driver": "rds_instance.available",
     "target": "db_identifier",
     "timeout_s": 900
    }
   },
   "ics_version": "0.1",
   "lifecycle": {
    "actions": {
     "observe": {
      "driver": "rds_instance.describe",
      "target": "db_identifier"
     },
     "snapshot": {
      "driver": "rds_instance.snapshot",
      "target": "db_identifier"
     },
     "start": {
      "driver": "rds_instance.start",
      "target": "db_identifier"
     },
     "stop": {
      "driver": "rds_instance.stop",
      "target": "db_identifier"
     }
    },
    "levels": {
     "awake": "RUNNING",
     "deep": "STOPPED",
     "hibernate": "SNAPSHOTTED",
     "shallow": "STOPPED"
    },
    "presence_variable": "present",
    "quirks": [
     {
      "auto_start_after_days": 7
     }
    ],
    "restore_variable": "restore_from_snapshot",
    "serving_states": [
     "RUNNING"
    ]
   },
   "outputs": {
    "db_identifier": {
     "stable": true
    },
    "endpoint_address": {
     "stable": true
    },
    "endpoint_port": {
     "stable": true
    },
    "security_group_id": {
     "stable": true
    }
   },
   "parameters": {
    "size": {
     "default": "small",
     "enum": [
      "small",
      "medium"
     ],
     "type": "string"
    }
   },
   "provides": [
    {
     "attributes": {
      "host": "endpoint_address",
      "name": "db_name",
      "password_param": "password_ssm_name",
      "port": "endpoint_port",
      "security_group_id": "security_group_id",
      "user": "db_user"
     },
     "port": "db",
     "type": "db.postgres/v1"
    }
   ],
   "requires": [
    {
     "inputs": {
      "private_subnet_ids": "subnet_ids",
      "vpc_id": "vpc_id"
     },
     "port": "net",
     "type": "net.vpc/v1",
     "when": "present"
    }
   ]
  }
 },
