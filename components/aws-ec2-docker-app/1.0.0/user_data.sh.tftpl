#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

mkdir -p /opt/infraflow
cat > /opt/infraflow/start.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail
DB_PASSWORD=$(aws ssm get-parameter --region ${region} --with-decryption \
  --name "${db_password_param}" --query Parameter.Value --output text)
docker rm -f app 2>/dev/null || true
for i in $(seq 1 30); do docker pull "${app_image}" && break; sleep 10; done
exec docker run --name app -p ${app_port}:${app_port} \
  -e PORT=${app_port} -e INFRAFLOW_ENV_ID=${env_id} \
  -e DB_HOST=${db_host} -e DB_PORT=${db_port} -e DB_NAME=${db_name} \
  -e DB_USER=${db_user} -e DB_PASSWORD="$DB_PASSWORD" \
  -e DATABASE_URL="postgresql://${db_user}:$DB_PASSWORD@${db_host}:${db_port}/${db_name}" \
  "${app_image}"
SCRIPT
chmod +x /opt/infraflow/start.sh

cat > /etc/systemd/system/infraflow-app.service <<'UNIT'
[Unit]
Description=InfraFlow application container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
ExecStart=/opt/infraflow/start.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now infraflow-app.service
